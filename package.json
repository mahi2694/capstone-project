{
  "name": "playwright-toolshop-capstone",
  "version": "1.0.0",
  "description": "Playwright + TypeScript e2e framework for the Conduit (RealWorld) app",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium --project=chromium-anonymous",
    "test:register": "playwright test tests/register.spec.ts --project=chromium-anonymous",
    "test:login": "playwright test tests/login.spec.ts --project=chromium-anonymous",
    "test:articles": "playwright test tests/articles.spec.ts --project=chromium",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  },
  "private": true
}
